local SURVIVE_ACHIEVEMENT = {
	Identifier = "Rose hell",
	Title = "Survived the rose coloured hell",
	Desc = "A hell full of roses",
	Reason = "Watch out when you hear his arrival",
	Image = ACHIEVEMENT_IMAGE
}

local DEATH_ACHIEVEMENT = {
	Identifier = "Too Many Roses",
	Title = "Too Many Roses",
	Desc = "Die To Rose Hell",
	Reason = "Die to Rose Hell",
	Image = ACHIEVEMENT_IMAGE
}

local playerDied = false
local achievementGranted = false

local function isPlayerDead(): boolean
	local character = game.Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	return humanoid == nil or humanoid.Health <= 0
end

local function grantAchievement(achievement)
	if achievementGranted then
		return
	end
	achievementGranted = true

	CustomAchievements:Grant(achievement, {
		CheckOwned = false,
		Remember = true
	})
end

